{
  "openapi": "3.0.1",
  "info": {
    "title": "RAWH.API",
    "version": "1.0"
  },
  "paths": {
    "/api/Auth/Register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/Login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/send-reset-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "email": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/verify-reset-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "code": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/set-new-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string"
                  },
                  "confirmPassword": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "password": {
                  "style": "form"
                },
                "confirmPassword": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/google-login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/PneumoniaSurvey": {
      "post": {
        "tags": [
          "PneumoniaSurvey"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/PneumoniaSurvey/{id}/upload-audio": {
      "post": {
        "tags": [
          "PneumoniaSurvey"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "AudioRecord": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "AudioRecord": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/PneumoniaSurvey/{id}": {
      "get": {
        "tags": [
          "PneumoniaSurvey"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "PneumoniaSurvey"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PneumoniaSurveyCreateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppetiteStatus": {
        "enum": [
          "RefusesCompletely",
          "EatsLessThanUsual",
          "EatsNormally"
        ],
        "type": "string"
      },
      "BreathingEffort": {
        "enum": [
          "Normal",
          "FastBreathing",
          "LooksExhausted"
        ],
        "type": "string"
      },
      "CoughSeverity": {
        "enum": [
          "Mild",
          "Moderate",
          "Severe"
        ],
        "type": "string"
      },
      "CoughTime": {
        "enum": [
          "IncreasesDaytime",
          "IncreasesNighttime",
          "ContinuousAllDay",
          "NoCough"
        ],
        "type": "string"
      },
      "CoughType": {
        "enum": [
          "DryCough",
          "ProductiveCough"
        ],
        "type": "string"
      },
      "FeedingAbility": {
        "enum": [
          "CanComplete",
          "StopsToCatchBreath",
          "DifficultyCompleting"
        ],
        "type": "string"
      },
      "FeverDuration": {
        "enum": [
          "LessThan24Hours",
          "From1To3Days",
          "MoreThan3Days",
          "NormalTemperature"
        ],
        "type": "string"
      },
      "FeverLevel": {
        "enum": [
          "LessThan38",
          "From38To39",
          "MoreThan39",
          "NotMeasured"
        ],
        "type": "string"
      },
      "FeverResponse": {
        "enum": [
          "ReducedEasily",
          "ReducedWithDifficulty",
          "NotReduced",
          "DidNotTakeMedicine"
        ],
        "type": "string"
      },
      "Gender": {
        "enum": [
          "Male",
          "Female"
        ],
        "type": "string"
      },
      "GoogleLoginDTO": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HasChestIndrawing": {
        "enum": [
          "Yes",
          "No",
          "Not_Sure"
        ],
        "type": "string"
      },
      "HeartCondition": {
        "enum": [
          "Yes",
          "No",
          "IDontKnow"
        ],
        "type": "string"
      },
      "LoginDTO": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PhlegmStatus": {
        "enum": [
          "EasyToExit",
          "DifficultToExit",
          "NoPhlegm"
        ],
        "type": "string"
      },
      "PneumoniaSurveyCreateDto": {
        "type": "object",
        "properties": {
          "childName": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "feverDuration": {
            "$ref": "#/components/schemas/FeverDuration"
          },
          "feverLevel": {
            "$ref": "#/components/schemas/FeverLevel"
          },
          "feverResponse": {
            "$ref": "#/components/schemas/FeverResponse"
          },
          "coughTime": {
            "$ref": "#/components/schemas/CoughTime"
          },
          "coughType": {
            "$ref": "#/components/schemas/CoughType"
          },
          "phlegmStatus": {
            "$ref": "#/components/schemas/PhlegmStatus"
          },
          "coughSeverity": {
            "$ref": "#/components/schemas/CoughSeverity"
          },
          "hasAbnormalBreathingSound": {
            "type": "boolean"
          },
          "breathingEffort": {
            "$ref": "#/components/schemas/BreathingEffort"
          },
          "feedingAbility": {
            "$ref": "#/components/schemas/FeedingAbility"
          },
          "hasChestIndrawing": {
            "$ref": "#/components/schemas/HasChestIndrawing"
          },
          "hasNasalFlaring": {
            "type": "boolean"
          },
          "hasCyanosis": {
            "type": "boolean"
          },
          "fatigueStatus": {
            "type": "boolean"
          },
          "appetiteStatus": {
            "$ref": "#/components/schemas/AppetiteStatus"
          },
          "hasWeakCry": {
            "type": "boolean"
          },
          "hasSevereRunnyNoseWithBreathingDifficulty": {
            "type": "boolean"
          },
          "recurrentChestIssues": {
            "$ref": "#/components/schemas/RecurrentChestIssues"
          },
          "heartCondition": {
            "$ref": "#/components/schemas/HeartCondition"
          }
        },
        "additionalProperties": false
      },
      "RecurrentChestIssues": {
        "enum": [
          "Significantly",
          "Sometimes",
          "Rarely"
        ],
        "type": "string"
      },
      "RegisterDTO": {
        "required": [
          "email",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}